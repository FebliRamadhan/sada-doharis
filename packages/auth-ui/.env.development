# Used by `pnpm dev:ui` (vite build --watch + static serve, no vite dev server)
# Browser calls auth-service directly; CORS already allows localhost:3002
VITE_API_URL=http://localhost:3001

# Optional: when set, GET / redirects the browser to this URL (default app).
# Leave empty to show the built-in SSO landing page.
VITE_DEFAULT_APP_URL=
