# ===========================================
# SADA API - Production Environment Template
# ===========================================
# Copy this file to .env.prod and fill in the values
# Usage: docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ===========================================

# Versioning
VERSION=1.0.0

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=sada_user
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=sada_db

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PASSWORD=your-redis-password-here

# ===========================================
# JWT Configuration
# ===========================================
# MUST be ≥ 32 chars and NOT contain "change-me" / "your-" / "default" / "secret-key"
# — service akan refuse start di production jika lemah.
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ===========================================
# OIDC Issuer (REQUIRED in production)
# ===========================================
# Public URL untuk OIDC discovery & token `iss` claim.
# Contoh: https://sso.menpan.go.id
OIDC_ISSUER=https://sso.your-domain.com

# ===========================================
# OAuth2 Token Lifetimes
# ===========================================
OAUTH_AUTHORIZATION_CODE_EXPIRES_IN=600
OAUTH_ACCESS_TOKEN_EXPIRES_IN=3600
OAUTH_REFRESH_TOKEN_EXPIRES_IN=2592000

# ===========================================
# RSA Keys (RS256 JWT signing)
# ===========================================
# Generate dengan: openssl genrsa -out keys/private.pem 2048
#                  openssl rsa -in keys/private.pem -pubout -out keys/public.pem
# Mount ./keys/ ke /app/keys di container.
RSA_KEY_ID=key-1

# ===========================================
# Admin / Internal Email Routing
# ===========================================
ADMIN_EMAILS=admin@your-domain.com
INTERNAL_EMAIL_DOMAIN=your-domain.com

# Pendaftaran mandiri lewat POST /auth/register (form "Daftar" di halaman login).
# Default MATI, dan di production sebaiknya tetap mati: pendaftaran ini tidak
# punya verifikasi email maupun persetujuan admin, sehingga akun yang lahir
# darinya adalah identitas anonim yang tetap bisa menyelesaikan OAuth flow ke
# seluruh client terdaftar. Jalur resmi: LDAP (INTERNAL) dan SPLP (GOVERNMENT).
REGISTRATION_ENABLED=false

# ===========================================
# MySQL (Employee Profiles — Optional)
# ===========================================
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=main_db

# ===========================================
# SSO Session Cookie (auth-service)
# ===========================================
# Signs the sada_sid HttpOnly cookie that powers cross-app SSO.
# MUST be set in production — falls back to JWT_SECRET if unset.
SESSION_COOKIE_SECRET=change-me-min-32-chars-different-from-jwt-secret
# Lifetime of an SSO session in Redis (15m / 1h / 7d)
SESSION_TTL=7d
# Set to a parent domain (e.g. .example.com) so the cookie is shared by every
# subdomain that talks to auth-service. Leave empty when auth-service and the
# auth-ui live on a single host.
SESSION_COOKIE_DOMAIN=

# ===========================================
# Application Ports
# ===========================================
GATEWAY_PORT=3000
AUTH_UI_PORT=3002

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGIN=https://your-frontend-domain.com

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Stricter limit for /auth/login, /auth/ldap/login, /auth/register
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
# Strict limit for /oauth/token & /oauth/revoke
TOKEN_RATE_LIMIT_MAX_REQUESTS=10

# ===========================================
# MFA / TOTP (auth-service)
# ===========================================
# AES-256-GCM key for encrypting TOTP secrets at rest.
# REQUIRED in production, min 32 chars. Generate: openssl rand -base64 48
MFA_SECRET_ENC_KEY=change-me-min-32-chars-generate-with-openssl-rand
# Label shown in authenticator apps (Google Authenticator, etc.)
MFA_ISSUER=SADA SSO
# true (default) = internal (LDAP) users must enroll MFA at first login.
# Set false for a gradual rollout.
MFA_REQUIRED_INTERNAL=true
# Seconds a pending (passed password, awaiting TOTP) login stays valid
MFA_PENDING_TTL=300

# ===========================================
# Account Lockout (Brute Force Protection)
# ===========================================
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ===========================================
# Audit & Cleanup
# ===========================================
AUDIT_LOG_ENABLED=true
TOKEN_CLEANUP_INTERVAL_MS=3600000

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info

# ===========================================
# LDAP Configuration (Optional)
# ===========================================
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTER=

# ===========================================
# SPLP (Government SSO) Configuration
# ===========================================
SPLP_CLIENT_ID=
SPLP_CLIENT_SECRET=
SPLP_AUTHORIZATION_URL=
SPLP_TOKEN_URL=
SPLP_USERINFO_URL=
SPLP_REDIRECT_URI=

# ===========================================
# Google OAuth Configuration (Optional)
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ===========================================
# Facebook OAuth Configuration (Optional)
# ===========================================
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=
